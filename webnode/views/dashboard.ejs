<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>ILdavBot</title>
    <link rel="icon" type="image/png" href="/images/icone.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Dashboard de trading accessible et moderne pour ILdavBot.">
    <meta name="theme-color" content="#18191e">
    <link rel="stylesheet" href="/css/style.css">
    
    <script defer src="/js/dashboard.js"></script>
   
</head>


<body>
    <div id="toast-container"></div>
<div class="container-main">
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-logo" style="margin-bottom:38px;">
            <img src="/images/logo.png" width="140" style="transition:width 0.2s;" alt="logo ILdavBot" aria-label="Logo ILdavBot">
            <button id="sidebar-toggle" aria-label="Réduire ou agrandir la barre latérale" style="background:none;border:none;position:absolute;right:10px;top:18px;font-size:1.6em;cursor:pointer;z-index:10;transition:transform 0.2s;">
                <span id="sidebar-toggle-icon">⏴</span>
            </button>
        </div>
        <h3 class="sidebar-title" style="margin-top:30px;">MENU</h3>
        <nav>
            <ul class="sidebar-menu">
                <li><a href="/dashboard" class="<%= (page === 'dashboard') ? 'active' : '' %>" data-icon="📊" title="Dashboard"><span>Dashboard</span></a></li>
                <li><a href="/trades" class="<%= (page === 'trades') ? 'active' : '' %>" data-icon="📈" title="Trades ouverts"><span>Trades ouverts</span></a></li>
                <li><a href="/journal" class="<%= (page === 'journal') ? 'active' : '' %>" data-icon="📒" title="Journal de trading"><span>Journal de trading</span></a></li>
                <li><a href="/logs" class="<%= (page === 'logs') ? 'active' : '' %>" data-icon="📝" title="Logs"><span>Logs</span></a></li>
                <li><a href="/parametre" class="<%= (page === 'parametre') ? 'active' : '' %>" data-icon="⚙️" title="Paramètres"><span>Paramètres</span></a></li>
                <li><a href="/guide" class="<%= (page === 'guide') ? 'active' : '' %>" data-icon="❓" title="Guide"><span>Guide</span></a></li>
                <li><a href="/logout" data-icon="🚪" title="Déconnexion" style="color:#ff6464;font-weight:600;"><span>Déconnexion</span></a></li>
            </ul>
        </nav>
    </aside>
    <!-- MAIN CONTENT -->
    <main class="main-content">
        <h1 class="main-title"><img src="https://img.icons8.com/ios-filled/50/4e96ff/combo-chart.png" width="38" style="vertical-align:-10px;margin-right:9px;">Dashboard général</h1>
        <% if (message) { %>
            <script>window.addEventListener('DOMContentLoaded',()=>showToast('<%= message %>','success'));</script>
        <% } %>
        <% if (error) { %>
            <script>window.addEventListener('DOMContentLoaded',()=>showToast('<%= error %>','error'));</script>
        <% } %>
        <div class="card-row">
            <div class="custom-card">
                <div class="card-title">Statut du bot</div>
                <form method="POST" action="/<%= config.enabled ? 'pause' : 'play' %>" style="margin-bottom:0;">
                    <button id="bot-status-btn" type="submit" class="emoji-btn" aria-label="<%= config.enabled ? 'Mettre en pause le bot' : 'Démarrer le bot' %>">
                        <% if (config.enabled) { %>
                            <span id="bot-status-icon" aria-hidden="true">⏸️</span>
                        <% } else { %>
                            <span id="bot-status-icon" aria-hidden="true">▶️</span>
                        <% } %>
                    </button>
                </form>
                <div class="statut-actif" id="bot-status-text" style="margin-top:10px;">
                    <% if (config.enabled) { %>
                        <span class="active-dot">● ACTIF</span>
                    <% } else { %>
                        <span style="color:#ff6464;font-weight:700;">● PAUSE</span>
                    <% } %>
                </div>
            </div>
            <div class="custom-card">
                <div class="card-title">Redémarrer</div>
                <form method="POST" action="/reset" style="margin-bottom:0;">
                    <button type="submit" class="emoji-btn" aria-label="Redémarrer le bot">
                        <span aria-hidden="true">🔄</span>
                    </button>
                </form>
            </div>
                <div class="custom-card" id="bot-global-status">
                <div class="card-title">État global</div>
                <div class="status-line" id="status-enabled">🤖 Bot : --</div>
                <div class="status-line" id="status-security">🔐 Sécurité : --</div>
                <div class="status-line" id="status-be">🎯 Break-even : --</div>
                <div class="status-line" id="status-tp-mode">📊 TP mode : --</div>
                <div class="status-line" id="status-cooldown">⏱ Cooldown : --</div>
                

            </div>
            <div class="custom-card" id="risk-summary">
                <div class="card-title">📊 Vision risque</div>

                <div class="risk-line" id="risk-percent">⚠️ Risque engagé : --%</div>
                <div class="risk-line" id="risk-sl">🔻 Perte max (SL) : --</div>
                <div class="risk-line" id="risk-correlated">🔗 Trades corrélés : --</div>
                <div class="risk-line" id="risk-secured">🟢 Profit sécurisé : --</div>
</div>
        </div>
        <div class="card-row">
    <div class="custom-card" id="quick-controls">
        <div class="card-title">🎛 Contrôles rapides</div>

        <!-- Break-even toggle -->
        <button class="quick-toggle" id="toggle-be"
                data-state="<%= config.break_even?.enabled ? 'on' : 'off' %>">
            🎯 Break-even :
            <span class="toggle-state">
                <%= config.break_even?.enabled ? 'ON' : 'OFF' %>
            </span>
        </button>

        <!-- Sécurité toggle -->
        <button class="quick-toggle" id="toggle-security"
                data-state="<%= config.security?.enabled ? 'on' : 'off' %>">
            🔐 Sécurité :
            <span class="toggle-state">
                <%= config.security?.enabled ? 'ON' : 'OFF' %>
            </span>
        </button>

        <hr style="width:100%;border:0;border-top:1px solid #333;margin:18px 0;">

        <!-- Blocage symbole (placeholder V1.5) -->
        <button class="quick-toggle warning" id="block-symbol-btn" disabled
                title="Bientôt disponible">
            🚫 Bloquer un symbole
        </button>

        <!-- Blocage canal -->
        <button class="quick-toggle warning" id="block-channel-btn" disabled
                title="Bientôt disponible">
            🔕 Bloquer un canal Telegram
        </button>

        <div style="font-size:0.9em;color:#888;margin-top:10px;">
            Certaines actions seront activées dans la prochaine version.
        </div>
    </div>
</div>

        <h3>🔔 Derniers signaux reçus</h3>
        <div id="signals-list">
            <% if (last_signals && last_signals.length) { %>
                <% last_signals.slice(-5).reverse().forEach(sig => { %>
                    <div style="margin-bottom:8px;">
                        <b><%= sig.symbol %> <%= sig.type %></b> |
                        Entrée: <%= sig.entry || '-' %> |
                        SL: <%= sig.sl || '-' %> |
                        TP: <%= Array.isArray(sig.tp) ? sig.tp.join(', ') : (sig.tp || '-') %>
                        <div style="font-size:0.95em;color:#aaa;">Reçu le <%= sig.time || '-' %></div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="color:#bbb;">Aucun signal récent détecté.</div>
            <% } %>
        </div>
        <h3 style="margin-top:28px;">🧠 Décisions du bot</h3>
        <div id="signal-feedback"></div>
        <h3 style="margin-top:32px;">📈 Trades ouverts</h3>
        <table>
            <thead>
                <tr>
                    <th>Symbole</th>
                    <th>Type</th>
                    <th>Lot</th>
                    <th>Entrée</th>
                    <th>SL</th>
                    <th>TP</th>
                    <th>Profit</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="trades-table-body">
                <% if (open_trades.length) { %>
                    <% open_trades.forEach(trade => { %>
                        <tr>
                            <td><%= trade.symbol %></td>
                            <td><%= trade.type %></td>
                            <td><%= trade.lot %></td>
                            <td><%= trade.entry %></td>
                            <td><%= trade.sl %></td>
                            <td><%= trade.tp %></td>
                            <td><%= trade.profit %></td>
                            <td>
                                <form method="POST" action="/close-trade" style="display:inline;">
                                    <input type="hidden" name="ticket" value="<%= trade.ticket %>">
                                    <button class="custom-btn red" type="submit">❌ Fermer</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="8" style="color:#bbb;">Aucune position ouverte pour le moment.</td></tr>
                <% } %>
            </tbody>
        </table>
        <hr style="margin:32px 0 18px 0; border:none; border-top:1px solid #333;">
        

        <!-- Bouton de réinitialisation des journaux -->
        <form method="POST" action="/reset-logs" onsubmit="return confirm('⚠️ Cette action va effacer tous les journaux (logs, trades, signaux) et remettre à zéro l\'historique. Continuer ?');" style="margin-bottom:0; margin-top:32px;">
            <button type="submit" class="custom-btn red" style="font-weight:bold;">🗑️ Effacer tous les journaux (logs, trades, signaux)</button>
        </form>
        <footer class="sticky-footer">
            <hr style="margin-top:5px; margin-bottom:10px; border: none; border-top: 1px solid #3a3a3a;">
            ILdavBot V1 — une solution simple, pour faire grandir vos ambitions de trading.<br>
            © 2025 Tous droits réservés.
        </footer>
    </main>
</div>
<!-- Toast container (toasts sont ajoutés dynamiquement) -->
<button class="theme-toggle" id="theme-toggle" title="Basculer mode clair/sombre">🌙</button>
</body>
</html>

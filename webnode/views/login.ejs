<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Connexion - ILdavBot</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .login-container {
            max-width: 370px;
            margin: 60px auto 0 auto;
            background: #17181d;
            border-radius: 18px;
            box-shadow: 0 3px 24px rgba(0,0,0,0.17);
            padding: 32px 28px;
        }
        .login-title {
            text-align: center;
            font-size: 1.5em;
            font-weight: 700;
            margin-bottom: 18px;
            color: #4e96ff;
        }
        .login-form label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }
        .login-form .input-group {
            position: relative;
            margin-bottom: 18px;
        }
        .login-form input[type="password"],
        .login-form input[type="text"] {
            width: 100%;
            padding: 10px 44px 10px 10px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #23242a;
            color: #eaeaea;
            font-size: 1.1em;
            box-sizing: border-box;
        }
        .toggle-pw {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            font-size: 1.25em;
            cursor: pointer;
            color: #4e96ff;
            padding: 0 4px;
            height: 32px;
            width: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-form button[type="submit"] {
            width: 100%;
            padding: 12px 0;
            border-radius: 10px;
            border: none;
            background: linear-gradient(90deg, #3499fa 0%, #5ae6b4 100%);
            color: #fff;
            font-size: 1.1em;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.18s;
        }
        .login-form button[type="submit"]:hover {
            background: linear-gradient(90deg, #247bc3 0%, #3cb98c 100%);
        }
        .login-error {
            color: #ff6464;
            text-align: center;
            margin-bottom: 12px;
            font-weight: 600;
        }
        .sticky-footer {
            position: relative;
            bottom: 0;
            width: 100%;
            text-align: center;
            padding: 10px 0;
            background: #17181d;
            color: #a0a0a0;
            font-size: 0.9em;
            border-top: 1px solid #3a3a3a;
        }
        @media (max-width: 600px) {
            body {
                margin: 0;
                padding: 0;
                min-height: 100vh;
                background: #17181d;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }
            .login-container {
                max-width: 98vw;
                margin: 32px auto 0 auto;
                padding: 18px 6vw;
                border-radius: 0 0 18px 18px;
                box-shadow: 0 2px 12px rgba(0,0,0,0.13);
            }
            .login-title {
                font-size: 1.2em;
            }
            .login-form input[type="password"],
            .login-form input[type="text"] {
                font-size: 1em;
                padding: 10px 38px 10px 10px;
            }
            .toggle-pw {
                font-size: 1.1em;
                height: 28px;
                width: 28px;
            }
            .login-form button[type="submit"] {
                font-size: 1em;
                padding: 10px 0;
            }
            .sticky-footer {
                font-size: 0.85em;
                padding: 8px 0;
            }
        }
        @media (max-width: 400px) {
            .login-container {
                padding: 10px 2vw;
            }
            .login-title {
                font-size: 1em;
            }
        }
        @media (min-width: 601px) and (max-width: 900px) {
            .login-container {
                max-width: 420px;
                margin: 40px auto 0 auto;
                padding: 28px 32px;
            }
            .login-title {
                font-size: 1.3em;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-title">🔒 Connexion</div>
        <% if (error) { %>
            <div class="login-error"><%= error %></div>
        <% } %>
        <form class="login-form" method="POST" action="/login" autocomplete="off">
            <label for="password">Mot de passe</label>
            <div class="input-group">
                <input type="password" id="password" name="password" required autocomplete="current-password">
                <button type="button" class="toggle-pw" id="toggle-pw" aria-label="Afficher ou masquer le mot de passe">👁️</button>
            </div>
            <button type="submit">Se connecter</button>
        </form>
    </div>
    <footer class="sticky-footer">
        <hr style="margin-top:5px; margin-bottom:10px; border: none; border-top: 1px solid #3a3a3a;">
        ILdavBot V1 — une solution simple, pour faire grandir vos ambitions de trading.<br>
        © 2025 Tous droits réservés.
    </footer>
    <script>
    const pwInput = document.getElementById('password');
    const toggleBtn = document.getElementById('toggle-pw');
    toggleBtn.onclick = function(e) {
        e.preventDefault();
        if (pwInput.type === 'password') {
            pwInput.type = 'text';
            toggleBtn.textContent = '🙈';
        } else {
            pwInput.type = 'password';
            toggleBtn.textContent = '👁️';
        }
    };
    </script>
</body>
</html>
